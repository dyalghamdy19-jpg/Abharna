@{
    ViewData["Title"] = "Login";
    string lastEmail = ViewBag.LastEmail as string ?? "";
}

<main class="wrap" style="padding-top: 30px;">

    <div class="formcol">
        <span class="section-label">ABHARNA &middot; AUTH</span>
        <h1>Sign in to ABHARNA</h1>
        <p class="lead">Use your account to follow ships and containers at Jeddah Islamic Port.</p>

        <div id="loginBox" class="formbox">
            <!-- ASP.NET: the form is sent (POST) to the Login action in AccountController -->
            <form name="loginForm" method="post" asp-controller="Account" asp-action="Login"
                  onsubmit="return checkLogin()" onreset="resetLogin()">

                <label for="email" class="fl">EMAIL</label>
                <input type="email" id="email" name="email" class="field" value="@lastEmail" placeholder="name@@abharna.sa"
                       required autofocus onfocus="highlight(this)" onblur="normal(this)">

                <label for="password" class="fl">PASSWORD</label>
                <input type="password" id="password" name="password" class="field" minlength="8"
                       placeholder="At least 8 characters" required onfocus="highlight(this)" onblur="normal(this)">

                <p>
                    <input type="checkbox" id="remember" name="remember" value="true" checked="@(lastEmail != "")">
                    <label for="remember">Remember my email (cookie)</label>
                </p>

                <p id="loginMsg" class="msg">@ViewBag.Error</p>
                @if (TempData["Message"] != null)
                {
                    <p class="msg" style="color: #2f7d52;">@TempData["Message"]</p>
                }

                <input type="submit" class="btn dark wide" value="Sign In">
                <p><input type="reset" class="btn" value="Clear"></p>
                <p class="small">Don't have an account? <a asp-controller="Account" asp-action="Signup" style="color: #a98550;">Register here</a></p>
            </form>
        </div>
    </div>

    <div class="sidecol">
        <span class="label">DEMO ACCOUNTS</span>
        <p class="small">Click a row to fill the form.</p>
        <table class="tbl">
            <caption>Accounts you can use to test the site</caption>
            <thead>
                <tr><th>Role</th><th>Email</th><th>Password</th></tr>
            </thead>
            <tbody>
                <tr onclick="fillDemo('staff@@abharna.sa', 'Staff.port')">
                    <td class="name">Port Staff</td>
                    <td>staff@@abharna.sa</td>
                    <td>Staff.port</td>
                </tr>
                <tr onclick="fillDemo('manager@@abharna.sa', 'Manager.port')">
                    <td class="name">Port Manager</td>
                    <td>manager@@abharna.sa</td>
                    <td>Manager.port</td>
                </tr>
                <tr onclick="fillDemo('customer@@abharna.sa', 'Customer.port')">
                    <td class="name">Customer</td>
                    <td>customer@@abharna.sa</td>
                    <td>Customer.port</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="clear"></div>
</main>

@section Scripts {
    <script>
        // JavaScript check before the form is sent to the server
        function checkLogin() {
            var email = document.forms["loginForm"]["email"].value;
            var pass = document.forms["loginForm"]["password"].value;
            if (email == "" || pass == "") {
                showMessage("loginMsg", "Please fill in all the fields.", true);
                return false;
            } else if (pass.length < 8) {
                showMessage("loginMsg", "The password must have 8 characters or more.", true);
                return false;
            }
            return true;
        }
    </script>
}
