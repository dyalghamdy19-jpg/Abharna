<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="ABHARNA Port Systems - cargo tracking at Jeddah Islamic Port">
    <meta name="author" content="CIS 24 - Group 3">
    <title>@ViewData["Title"] - ABHARNA Port Systems</title>

    <!-- External CSS and external JavaScript -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <script src="~/js/script.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a id="top"></a>

    <!-- MASTER PAGE: header + menu (same in every page) -->
    <header id="topbar">
        <div class="wrap">
            <div class="brand">
                <!-- Image map: clicking the logo opens About Us -->
                <img src="~/images/logo.jpeg" alt="ABHARNA logo" width="69" height="61" usemap="#logomap">
                <map name="logomap">
                    <area shape="rect" coords="0,0,69,61" href="@Url.Action("About", "Home")" alt="About Us" title="About Us">
                </map>
                <a asp-controller="Home" asp-action="Index" class="brandtext">ABHARNA<br><span class="sub">PORT SYSTEMS</span></a>
            </div>

            <nav id="menu">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" id="menu_home">Home</a></li>
                    <li>
                        <a asp-controller="Home" asp-action="About" id="menu_about">About Us</a>
                        <ul>
                            <li><a asp-controller="Home" asp-action="About" asp-fragment="team">Our Team</a></li>
                            <li><a asp-controller="Home" asp-action="About" asp-fragment="sitemap">Site Map</a></li>
                        </ul>
                    </li>
                    <li><a asp-controller="Account" asp-action="Login" id="menu_login">Login</a></li>
                    <li><a asp-controller="Account" asp-action="Signup" id="menu_signup">Sign Up</a></li>
                    <li><a asp-controller="Track" asp-action="Index" id="menu_track">Track Cargo</a></li>
                </ul>
            </nav>
            <div class="clear"></div>
        </div>
    </header>

    <!-- The content of each page goes here -->
    @RenderBody()

    <!-- MASTER PAGE: footer -->
    <footer id="footer">
        <div class="wrap">
            <p>
                <a asp-controller="Home" asp-action="Index">Home</a> |
                <a asp-controller="Home" asp-action="About">About Us</a> |
                <a asp-controller="Track" asp-action="Index">Track Cargo</a> |
                <a asp-controller="Account" asp-action="Login">Login</a> |
                <a asp-controller="Account" asp-action="Signup">Sign Up</a> |
                <a href="#top">Back to top &uarr;</a>
            </p>
            <p>ABHARNA PORT SYSTEMS &middot; CIS 24 &middot; CPIS358</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>